{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build && pagefind --site dist",
    "preview": "vite preview",
    "test:unit": "vitest --project unit",
    "test:visual": "vitest --project vrt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "lint:text": "textlint \"app/routes/blog/(content)/*.{md,mdx}\"",
    "lint:text:fix": "textlint --fix \"app/routes/blog/(content)/*.{md,mdx}\"",
    "lint:text:github": "textlint --format=github \"app/routes/blog/(content)/*.{md,mdx}\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@hono/react-renderer": "^1.0.1",
    "@primer/react-brand": "^0.76.0",
    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/helpers": "^2.14.0",
    "hono": "^4.13.9",
    "honox": "0.1.61",
    "lightningcss": "^1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@blazediff/vitest": "^1.1.25",
    "@hono/vite-ssg": "^0.3.3",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pagefind": "^1.5.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.28.3"
}
